{
  "name": "regex-for-humans",
  "version": "0.1.0-dev",
  "description": "Compile controlled English rules into explained JavaScript regular expressions",
  "keywords": [
    "regex",
    "regular-expressions",
    "developer-tools",
    "cli",
    "controlled-language"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmaneBlial/Regex-For-Humans.git"
  },
  "bugs": {
    "url": "https://github.com/OthmaneBlial/Regex-For-Humans/issues"
  },
  "homepage": "https://othmaneblial.github.io/Regex-For-Humans/",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "bin": {
    "regex-for-humans": "./bin/regex-for-humans.js"
  },
  "scripts": {
    "test": "node scripts/run-node-tests.js",
    "test:package": "node scripts/verify-package.js",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-doc-links.js",
    "check": "biome check . && npm run typecheck && npm run docs:check",
    "build": "node scripts/build-web.js && node scripts/check-doc-links.js dist",
    "build:share-card": "node scripts/build-share-card.js",
    "build:pages": "npm run build && node scripts/build-pages-workshop.js",
    "serve": "node scripts/serve-dist.js",
    "test:browser": "playwright test",
    "test:compat": "playwright test --config=playwright.compat.config.js",
    "verify": "npm run check && npm test && npm run build:pages && npm run test:package && npm run test:browser && npm run test:compat && npm run build:share-card && npm run test:site && npm audit --audit-level=moderate",
    "test:site": "playwright test --config=playwright.site.config.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "bin/",
    "docs/",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  }
}
