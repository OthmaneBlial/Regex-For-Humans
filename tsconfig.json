{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "WebWorker"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["index.js", "src/**/*.js", "bin/**/*.js"]
}
