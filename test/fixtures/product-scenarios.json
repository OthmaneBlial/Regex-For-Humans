[
  {
    "id": "prefixed-identifier",
    "title": "Validate a prefixed identifier",
    "rules": "start \"ABC\"\n3 digits\nend",
    "source": "^ABC\\d{3}$",
    "flags": "u",
    "matchMode": "full",
    "positive": ["ABC123"],
    "negative": ["ABC12", "ABC1234", "abc123"]
  },
  {
    "id": "excluded-characters",
    "title": "Exclude characters",
    "rules": "start\nnone of: a, b, c, d any number of times\nend",
    "source": "^[^abcd]*$",
    "flags": "u",
    "matchMode": "full",
    "positive": ["xyz", ""],
    "negative": ["cab"]
  },
  {
    "id": "line-rule",
    "title": "Read a line rule",
    "rules": "line start\nany character any number of times\n3 digits\nline end",
    "source": "^.*\\d{3}$",
    "flags": "mu",
    "matchMode": "search",
    "positive": ["item 123", "note\nitem 123"],
    "negative": ["item 12"]
  }
]
