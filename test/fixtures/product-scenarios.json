[
  {
    "id": "prefixed-identifier",
    "title": "Validate a prefixed identifier",
    "rules": "start \"ABC\"\n3 digits\nend",
    "source": "^ABC\\d{3}$",
    "flags": "u",
    "matchMode": "full",
    "positive": ["ABC123"],
    "negative": ["ABC12", "ABC1234", "abc123"]
  },
  {
    "id": "excluded-characters",
    "title": "Exclude characters",
    "rules": "start\ntext without: a, b, c, d\nend",
    "source": "^[^abcd]*$",
    "flags": "u",
    "matchMode": "full",
    "positive": ["xyz", ""],
    "negative": ["cab"]
  },
  {
    "id": "line-rule",
    "title": "Read a line rule",
    "rules": "line start\nany text\n3 digits\nline end",
    "source": "^.*\\d{3}$",
    "flags": "mu",
    "matchMode": "search",
    "positive": ["item 123", "note\nitem 123"],
    "negative": ["item 12"]
  },
  {
    "id": "date-shape",
    "title": "Match a date shape",
    "rules": "start\n4 digits\n\"-\"\n2 digits\n\"-\"\n2 digits\nend",
    "source": "^\\d{4}-\\d{2}-\\d{2}$",
    "flags": "u",
    "matchMode": "full",
    "positive": ["2026-09-27", "2000-01-01", "2026-02-31"],
    "negative": ["2026-9-27", "27-09-2026", "2026/09/27"]
  }
]
